  },
  "packageManager": "pnpm@10.30.1",
  "peerDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "hono": "4.13.8",
    "typescript": "7.0.2"
  }
}
