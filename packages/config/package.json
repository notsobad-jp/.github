{
  "name": "@notsobad/config",
  "version": "0.1.0",
  "private": true,
  "description": "notsobad-jpの共通Biome・TypeScript設定",
  "type": "module",
  "exports": {
    "./biome": "./biome.json",
    "./tsconfig.json": "./tsconfig.json"
  },
  "files": [
